# ============================================
# CASAÑAS PROPIEDADES - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite for dev, change to PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=change_this_to_a_very_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Admin seed credentials (used only during initial db:seed)
ADMIN_EMAIL=admin@casanaspropiedades.com
ADMIN_PASSWORD=CasanasAdmin2024!
ADMIN_NAME=Administrador

# WhatsApp contact number (with country code, no spaces or symbols)
WHATSAPP_NUMBER=5491112345678

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload limits
MAX_FILE_SIZE=5242880
MAX_FILES_PER_PROPERTY=15

